# VITE_* values are public and embedded into the production bundle at build time.
# Configure real HTTPS URLs before `npm run build`; rebuilding is required after changes.
# Do not add private keys, passwords, JWT secrets, database or SMTP credentials here.
VITE_API_BASE_URL=https://api.your-domain.example/api/v1
VITE_STOREFRONT_URL=https://www.your-domain.example
