NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naturalbeauty
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUIRE_HTTPS=false
COOKIE_DOMAIN=
MEDIA_STORAGE_ROOT=
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/uploads
MEDIA_SCAN_COMMAND=

JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=nb_refresh
DEV_CUSTOMER_PASSWORD=replace-for-local-development-only

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ONLINE_PAYMENT_RESERVATION_MINUTES=30

# Cashfree Payments (server-side only)
# Set CASHFREE_ENABLED=true after adding valid credentials.
CASHFREE_ENABLED=false
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional override; defaults to CASHFREE_CLIENT_SECRET for webhook verification.
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:4000

# SMTP fallback values (admin Settings can override these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_JWT_ACCESS_SECRET=replace-with-a-separate-long-random-admin-secret
ADMIN_ACCESS_TOKEN_TTL=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_REFRESH_COOKIE_NAME=nb_admin_refresh
DEV_ADMIN_EMAIL=admin@naturalbeauty.local
DEV_ADMIN_PASSWORD=replace-for-local-development-only
