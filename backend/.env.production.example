# Copy these names into your secret manager/provider settings. Never commit the filled file.
NODE_ENV=production
PORT=4000

DB_HOST=managed-mariadb-host
DB_PORT=3306
DB_NAME=naturalbeauty_production
DB_USER=naturalbeauty_app
DB_PASSWORD=generate-in-secret-manager
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Separate random values, minimum 64 characters each.
JWT_ACCESS_SECRET=generate-a-random-64-plus-character-value
ADMIN_JWT_ACCESS_SECRET=generate-a-different-random-64-plus-character-value
ACCESS_TOKEN_TTL=15m
ADMIN_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=nb_refresh
ADMIN_REFRESH_COOKIE_NAME=nb_admin_refresh
COOKIE_DOMAIN=.your-domain.example

CORS_ORIGINS=https://www.your-domain.example,https://admin.your-domain.example
TRUST_PROXY=1
REQUIRE_HTTPS=true
STOREFRONT_URL=https://www.your-domain.example
ADMIN_URL=https://admin.your-domain.example
PUBLIC_API_URL=https://api.your-domain.example

# Use a mounted persistent volume or replace the media service with object storage before launch.
MEDIA_STORAGE_ROOT=/var/lib/naturalbeauty/uploads
MEDIA_PUBLIC_BASE_URL=https://api.your-domain.example/uploads
# Optional command used to scan a temporary upload before it is accepted.
MEDIA_SCAN_COMMAND=

CASHFREE_ENABLED=false
# Initial hosted inspection uses sandbox. Switch only after public-launch approval.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=store-in-secret-manager
CASHFREE_CLIENT_SECRET=store-in-secret-manager
CASHFREE_WEBHOOK_SECRET=store-in-secret-manager
CASHFREE_API_VERSION=2025-01-01
ONLINE_PAYMENT_RESERVATION_MINUTES=30

# Razorpay is backend-only. Keep disabled for the initial hosted inspection.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_USER=store-in-secret-manager
SMTP_PASSWORD=store-in-secret-manager
SMTP_FROM_EMAIL=orders@your-domain.example
ADMIN_NOTIFICATION_EMAIL=ops@your-domain.example

# Operational scripts only; do not put backups inside a publicly served directory.
BACKUP_DIR=/var/backups/naturalbeauty
BACKUP_RETENTION_DAYS=30
# Restore is intentionally confirmation-gated. Set only for an approved restore.
CONFIRM_RESTORE=
